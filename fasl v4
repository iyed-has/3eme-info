 c.innerHTML='<div class="head"><div><h2>الشات العام</h2><p>واجهة مستقلة لجميع المحادثات، ولا تختلط بشات المكالمة.</p></div></div><section class="panel general"><div class="contacts"><div class="contact active" data-thread="class"><div class="avatar">3</div><div><strong>شات القسم العام</strong><small>كل القسم</small></div></div><div class="contact" data-thread="teacher"><div class="avatar">أ</div><div><strong>الأستاذ</strong><small>محادثة مع الأستاذ</small></div></div><div class="contact" data-thread="students"><div class="avatar">👥</div><div><strong>التلاميذ</strong><small>محادثة التلاميذ</small></div></div></div><div class="thread"><div class="thread-head"><div class="avatar" id="threadAvatar">3</div><div><strong id="threadTitle">شات القسم العام</strong><small>رسائل الشات العام</small></div></div><div class="messages" id="messages"></div><form class="compose" id="compose"><input id="msgInput" placeholder="اكتب رسالة..." maxlength="500"><input class="file-pick" id="generalImageInput" type="file" accept="image/*"><button type="button" class="attach-btn" id="generalAttach" title="إرفاق صورة" aria-label="إرفاق صورة">🖼️</button><button>إرسال ➤</button></form></div></section>';
 thread="class";showThread(thread);
 $$(".contact").forEach(b=>b.onclick=()=>{thread=b.dataset.thread;$$(".contact").forEach(x=>x.classList.toggle("active",x===b));showThread(thread);});
 $("#compose").onsubmit=async e=>{e.preventDefault();const input=$("#msgInput"),v=input.value.trim();if(!v)return;chats[thread].push({id:Date.now()+Math.random(),sender:username,text:v,mine:true,role,createdAt:Date.now()});safeSave("fasl_chats_v3",chats);input.value="";showThread(thread);};
 $("#generalAttach").onclick=()=>$("#generalImageInput").click();
 $("#generalImageInput").onchange=async e=>{const f=e.target.files&&e.target.files[0];if(!f)return;if(!f.type.startsWith("image/")){toast("اختر ملف صورة فقط.");e.target.value="";return;}if(f.size>1200000){toast("حجم الصورة يجب أن يكون أقل من 1.2 ميغابايت في هذه النسخة التجريبية.");e.target.value="";return;}try{const data=await readImageFile(f);chats[thread].push({id:Date.now()+Math.random(),sender:username,text:"",image:data,imageName:f.name,mine:true,role,createdAt:Date.now()});safeSave("fasl_chats_v3",chats);showThread(thread);toast("تم إرفاق الصورة في النسخة التجريبية على هذا الجهاز.");}catch(err){toast("تعذّر تحميل الصورة.");}e.target.value="";};
}
function readImageFile(file){return new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(String(r.result));r.onerror=reject;r.readAsDataURL(file);});}
function showThread(k){const titles={class:"شات القسم العام",teacher:"الأستاذ",students:"التلاميذ"};$("#threadTitle").textContent=titles[k];$("#threadAvatar").textContent=k==="class"?"3":k==="teacher"?"أ":"👥";const box=$("#messages");box.innerHTML="";(chats[k]||[]).forEach((m,index)=>{const el=document.createElement("div");el.className="gmsg"+(m.mine?" mine":"");let content=m.image?'<img class="message-media" src="'+m.image+'" alt="صورة مرفقة">':'';if(m.text)content+='<div class="gbubble">'+esc(m.text)+'</div>';let del=role==="teacher"?'<div class="msg-tools"><button class="delete-msg" data-delete-message="'+esc(m.id??index)+'">🗑️ حذف</button></div>':'';el.innerHTML='<small>'+esc(m.sender||"مستخدم")+'</small>'+content+del;box.appendChild(el);});if(role==="teacher")box.querySelectorAll('[data-delete-message]').forEach(b=>b.onclick=()=>{const id=b.dataset.deleteMessage;chats[k]=(chats[k]||[]).filter((m,i)=>String(m.id??i)!==id);safeSave("fasl_chats_v3",chats);showThread(k);toast("حُذفت الرسالة من هذا الجهاز.");});box.scrollTop=box.scrollHeight;}
async function share(){if(!navigator.mediaDevices||!navigator.mediaDevices.getDisplayMedia){toast("مشاركة الشاشة تحتاج متصفحًا يدعمها مثل Chrome، ويفضل فتح الموقع عبر HTTPS.");return;}try{stopScreen();screenStream=await navigator.mediaDevices.getDisplayMedia({video:true,audio:false});const stage=$("#stage");if(!stage)return;stage.innerHTML="";const v=document.createElement("video");v.autoplay=true;v.playsInline=true;v.muted=true;v.srcObject=screenStream;stage.appendChild(v);const label=document.createElement("div");label.className="stage-label";label.textContent="معاينة مشاركة الشاشة";stage.appendChild(label);await v.play().catch(()=>{});screenStream.getVideoTracks()[0].addEventListener("ended",()=>{screenStream=null;if($("#stage"))$("#stage").innerHTML='<div class="stage-default"><div class="person">👨‍🏫</div><strong>قاعة الدرس</strong><p>انتهت مشاركة الشاشة.</p></div>';});toast("معاينة الشاشة ظاهرة الآن داخل القاعة.");}catch(e){toast("لم تبدأ المشاركة. اسمح للمتصفح بمشاركة الشاشة ثم أعد المحاولة.");}}
function stopScreen(){if(screenStream){screenStream.getTracks().forEach(t=>t.stop());screenStream=null;}}
function endCall(){stopScreen();stopMedia();callActive=false;inCall=false;page="home";render();toast("تم إنهاء المكالمة التجريبية.");}
</script></body></html>
